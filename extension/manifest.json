{
  "manifest_version": 3,
  "name": "W365 Copilot Harness",
  "version": "0.1.0",
  "description": "Runs tool calls from M365 Copilot replies through a local PowerShell agent.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://m365.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "W365 Copilot Harness"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m365.cloud.microsoft/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "lib/*.js"
      ],
      "matches": [
        "https://m365.cloud.microsoft/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
